# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=
RATE_LIMIT_SECRET=
# Solo fuera de Vercel y detrás de un proxy que sobrescriba esta cabecera.
RATE_LIMIT_IP_HEADER=

# Local PostgreSQL defaults match docker-compose.yml.
POSTGRES_DB=reludcir
POSTGRES_USER=reludcir
POSTGRES_PASSWORD=reludcir_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reludcir:reludcir_local@localhost:5432/reludcir
DATABASE_DIRECT_URL=postgresql://reludcir:reludcir_local@localhost:5432/reludcir
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
DATABASE_APPLICATION_NAME=reludcir-web

# Google Maps / Places. Restrict the browser key by hostname and API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Manual payments
YAPE_NUMBER=
YAPE_HOLDER=
BANK_NAME=
BANK_ACCOUNT=
BANK_CCI=
BANK_HOLDER=
PAYMENTS_OPERATIONS_EMAIL=
SUPPORT_OPERATIONS_EMAIL=
WHATSAPP_CONTACT_NUMBER=+51 994 358 300

# Transactional email
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_URL=https://api.resend.com/emails

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_BOOKING_CREATED=
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=
WHATSAPP_TEMPLATE_BOOKING_RESCHEDULED=

# Scheduled jobs and analytics
CRON_SECRET=
NEXT_PUBLIC_GTM_ID=

# Local/dev seed always creates this admin unless you override both values.
# Never use these credentials in production.
SEED_ADMIN_EMAIL=nina.v@example.com
SEED_ADMIN_PASSWORD=Reludcir#Admin26
